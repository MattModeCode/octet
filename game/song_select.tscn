; -----------------------------------------------------------------------
; Song select, imported from "Octet - Song Select.dc.html"
; (docs/DESIGN_HANDOFF.md). Colours baked as literal DesignTokens values
; -- .tscn parses before autoloads exist, same documented exception as
; game/gameplay.tscn:
;   COLOR_INK             #0C0A0F -> Color(0.047, 0.039, 0.059, 1)
;   COLOR_SURFACE         #16131B -> Color(0.086275, 0.07451, 0.105882, 1)
;   COLOR_SURFACE_RAISED  #1F1A26 -> Color(0.121569, 0.101961, 0.14902, 1)
;   COLOR_HAIRLINE        #2A2431 -> Color(0.164706, 0.141176, 0.192157, 1)
;   COLOR_TEXT_PRIMARY    #F5F1F5 -> Color(0.960784, 0.945098, 0.960784, 1)
;   COLOR_TEXT_SECONDARY  #A79FAE -> Color(0.654902, 0.623529, 0.682353, 1)
;   COLOR_TEXT_MUTED      #6E6676 -> Color(0.431373, 0.4, 0.462745, 1)
;   COLOR_PINK            #FF2D6E -> Color(1, 0.176471, 0.431373, 1)
;   COLOR_AMBER           #FFC93C -> Color(1, 0.788235, 0.235294, 1)
;
; Rows, difficulty chips, and cover-art placeholder textures are built by
; song_select.gd since they're data-driven; the panes/header/preview-box
; skeleton below is static per the mockup.
;
; Known deviations from the mockup (documented per CLAUDE.md's
; design-fidelity rule): cover/preview swatches are square-cornered, not
; rounded (Godot TextureRect has no corner-radius clip without a shader);
; the "YOUR BEST" card and profile-adjacent sample data are placeholders
; ("--") rather than the mockup's sample numbers, since no score
; persistence exists yet (not faking data per the same rule); the "⋯"
; overflow button has no defined action in the brief and is inert.
; -----------------------------------------------------------------------

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_list_pane"]
bg_color = Color(0, 0, 0, 0)
border_width_right = 1
border_color = Color(0.164706, 0.141176, 0.192157, 1)

