[gd_scene load_steps=8 format=3]

[ext_resource type="Script" path="res://game/results.gd" id="1_resultsgd"]
[ext_resource type="Theme" path="res://assets/theme/octet_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://ui/radial_background.tscn" id="3_radialbg"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_display.tres" id="4_fontdisplay"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_mono.tres" id="5_fontmono"]

; -----------------------------------------------------------------------
; Results, imported from "Octet - Results.dc.html" (docs/DESIGN_HANDOFF.md).
; Colours baked as literal DesignTokens values -- .tscn parses before
; autoloads exist, same documented exception as game/gameplay.tscn:
;   COLOR_INK             #0C0A0F -> Color(0.047, 0.039, 0.059, 1)
;   COLOR_SURFACE         #16131B -> Color(0.086275, 0.07451, 0.105882, 1)
;   COLOR_SURFACE_RAISED  #1F1A26 -> Color(0.121569, 0.101961, 0.14902, 1)
;   COLOR_HAIRLINE        #2A2431 -> Color(0.164706, 0.141176, 0.192157, 1)
;   COLOR_TEXT_PRIMARY    #F5F1F5 -> Color(0.960784, 0.945098, 0.960784, 1)
;   COLOR_TEXT_SECONDARY  #A79FAE -> Color(0.654902, 0.623529, 0.682353, 1)
;   COLOR_TEXT_MUTED      #6E6676 -> Color(0.431373, 0.4, 0.462745, 1)
;   COLOR_PINK            #FF2D6E -> Color(1, 0.176471, 0.431373, 1)
;   COLOR_AMBER           #FFC93C -> Color(1, 0.788235, 0.235294, 1)
;   COLOR_PERFECT_FLASH   #FFF4D6 -> Color(1, 0.956863, 0.839216, 1)
;   COLOR_MISS             #4A444F -> Color(0.290196, 0.266667, 0.309804, 1)
;
; Per-judgment breakdown bars and the hit-timing histogram are built by
; results.gd since they're data-driven (Judgment counts / hit_errors); the
; grade/stats/card skeleton below is static per the mockup. NewBestLabel
; (under GradeLabel) is populated by results.gd from PlaySession.
; last_run_is_new_best (WP-E) -- empty text when this run wasn't a best.
; -----------------------------------------------------------------------

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_histogram_card"]
bg_color = Color(0.086275, 0.07451, 0.105882, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
