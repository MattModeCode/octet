[gd_scene load_steps=12 format=3]

[ext_resource type="Script" path="res://game/gameplay.gd" id="1_gameplaygd"]
[ext_resource type="Theme" path="res://assets/theme/octet_theme.tres" id="2_theme"]
[ext_resource type="Script" path="res://game/playfield_view.gd" id="3_playfieldviewgd"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_mono.tres" id="4_fontmono"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_display.tres" id="5_fontdisplay"]
[ext_resource type="PackedScene" path="res://ui/radial_background.tscn" id="6_radialbg"]

; -----------------------------------------------------------------------
; 1a "Classic centered" gameplay HUD, imported from
; "Octet - Gameplay HUD.dc.html" (docs/DESIGN_HANDOFF.md). Colours below
; are literal DesignTokens values baked in -- Resource files (.tscn/.tres)
; are parsed before autoloads exist, so they can't reference the
; DesignTokens singleton at load time (same documented exception as
; assets/theme/octet_theme.tres). Keep in sync by hand if the palette
; changes:
;   COLOR_INK             #0C0A0F -> Color(0.047, 0.039, 0.059, 1)
;   COLOR_SURFACE_RAISED  #1F1A26 -> Color(0.121569, 0.101961, 0.14902, 1)
;   COLOR_HAIRLINE        #2A2431 -> Color(0.164706, 0.141176, 0.192157, 1)
;   COLOR_TEXT_PRIMARY    #F5F1F5 -> Color(0.960784, 0.945098, 0.960784, 1)
;   COLOR_TEXT_SECONDARY  #A79FAE -> Color(0.654902, 0.623529, 0.682353, 1)
;   COLOR_TEXT_MUTED      #6E6676 -> Color(0.431373, 0.4, 0.462745, 1)
;   COLOR_PINK            #FF2D6E -> Color(1, 0.176471, 0.431373, 1)
;   COLOR_AMBER           #FFC93C -> Color(1, 0.788235, 0.235294, 1)
;   COLOR_DANGER          #FF3B3B -> Color(1, 0.231373, 0.231373, 1)
;
; Fidelity-pass note (CLAUDE.md design-fidelity rule): the background radial
; glow + breathing vignette and the health bar's rounded pink->amber
; gradient fill were previously cut as "decorative" -- both restored here.
; Known remaining deviation: the health fill has no box-shadow glow (no
; cheap Godot Control equivalent at this 8px scale) and its square-cornered
; TextureRect can show a hairline-scale sliver past the track's rounded
; end-caps (Godot StyleBoxFlat corner rounding isn't a true clip mask).
; -----------------------------------------------------------------------

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_pill"]
bg_color = Color(0, 0, 0, 0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.788235, 0.235294, 1)
corner_radius_top_left = 20
corner_radius_top_right = 20
corner_radius_bottom_right = 20
corner_radius_bottom_left = 20
content_margin_left = 10.0
content_margin_top = 3.0
content_margin_right = 10.0
content_margin_bottom = 3.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_health_track"]
bg_color = Color(0.164706, 0.141176, 0.192157, 1)
corner_radius_top_left = 20
corner_radius_top_right = 20
corner_radius_bottom_right = 20
corner_radius_bottom_left = 20

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_health_bg"]
bg_color = Color(0.121569, 0.101961, 0.14902, 1)
corner_radius_top_left = 20
corner_radius_top_right = 20
corner_radius_bottom_right = 20
corner_radius_bottom_left = 20

[sub_resource type="Gradient" id="Gradient_health_fill"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 0.176471, 0.431373, 1, 1, 0.788235, 0.235294, 1)

[sub_resource type="GradientTexture2D" id="GradientTexture2D_health_fill"]
gradient = SubResource("Gradient_health_fill")
width = 640
height = 8
fill_from = Vector2(0, 0.5)
fill_to = Vector2(1, 0.5)

