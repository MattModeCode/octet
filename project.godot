; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Octet"
config/description="An eight-lane keyboard rhythm game with a built-in beat-mapping editor and an online map community."
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon.svg"

[autoload]

Config="*res://core/config.gd"
DesignTokens="*res://core/design_tokens.gd"
SettingsStore="*res://core/settings_store.gd"
LaneInput="*res://core/lane_input.gd"
PlaySession="*res://core/play_session.gd"
ScoreStore="*res://core/score_store.gd"
EditorSession="*res://editor/editor_session.gd"
Conductor="*res://audio/conductor.gd"
SceneRouter="*res://ui/scene_router.gd"
Net="*res://net/net_client.gd"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/mode=3
window/size/resizable=false
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
