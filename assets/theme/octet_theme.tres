[resource]
default_font = ExtResource("1")
default_font_size = 16

Button/styles/normal = SubResource("StyleBoxFlat_btn_normal")
Button/styles/hover = SubResource("StyleBoxFlat_btn_hover")
Button/styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
Button/styles/focus = SubResource("StyleBoxFlat_btn_focus")
Button/styles/disabled = SubResource("StyleBoxFlat_btn_disabled")
Button/colors/font_color = Color(0.960784, 0.945098, 0.960784, 1)
Button/colors/font_hover_color = Color(0.960784, 0.945098, 0.960784, 1)
Button/colors/font_pressed_color = Color(0.960784, 0.945098, 0.960784, 1)
Button/colors/font_focus_color = Color(0.960784, 0.945098, 0.960784, 1)
Button/colors/font_disabled_color = Color(0.431373, 0.4, 0.462745, 1)

Panel/styles/panel = SubResource("StyleBoxFlat_panel_card")
PanelContainer/styles/panel = SubResource("StyleBoxFlat_panel_card")
