PrimaryButton/colors/font_pressed_color = Color(0.047059, 0.039216, 0.058824, 1)
PrimaryButton/colors/font_focus_color = Color(0.047059, 0.039216, 0.058824, 1)
PrimaryButton/colors/font_disabled_color = Color(0.047059, 0.039216, 0.058824, 1)
PrimaryButton/font_sizes/font_size = 15

SecondaryButton/base_type = &"Button"
