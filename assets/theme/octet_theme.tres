[gd_resource type="Theme" load_steps=37 format=3]

[ext_resource type="FontVariation" path="res://assets/fonts/font_ui.tres" id="1"]

; -----------------------------------------------------------------------
; Octet theme — base Theme resource per docs/DESIGN_BRIEF.md §7.
;
; Literal hex values below are duplicated from core/design_tokens.gd
; (Theme resources are parsed before autoloads exist, so they cannot
; reference the DesignTokens singleton at load time). Keep these in sync
; by hand if the palette changes:
;   COLOR_INK             #0C0A0F -> Color(0.047059, 0.039216, 0.058824, 1)
;   COLOR_SURFACE        #16131B -> Color(0.086275, 0.07451, 0.105882, 1)
;   COLOR_SURFACE_RAISED  #1F1A26 -> Color(0.121569, 0.101961, 0.14902, 1)
;   COLOR_HAIRLINE        #2A2431 -> Color(0.164706, 0.141176, 0.192157, 1)
;   COLOR_TEXT_PRIMARY    #F5F1F5 -> Color(0.960784, 0.945098, 0.960784, 1)
;   COLOR_TEXT_SECONDARY  #A79FAE -> Color(0.654902, 0.623529, 0.682353, 1)
;   COLOR_TEXT_MUTED      #6E6676 -> Color(0.431373, 0.4, 0.462745, 1)
;   COLOR_PINK            #FF2D6E -> Color(1, 0.176471, 0.431373, 1)
;   COLOR_AMBER           #FFC93C -> Color(1, 0.788235, 0.235294, 1)
;   COLOR_MISS            #4A444F -> Color(0.290196, 0.266667, 0.309804, 1)
;   COLOR_DANGER          #FF3B3B -> Color(1, 0.231373, 0.231373, 1)
;
; Scope: base font/font_size defaults, the default Button/Panel styles
; (Stage 0 foundation, unchanged — screens already ship against these),
; plus WP-N's shared component-sheet additions: PrimaryButton/
; SecondaryButton/GhostButton/DestructiveButton type variations,
; CardSelected/StatCard Panel variations, and default LineEdit/
; OptionButton styling — all built from a live re-fetch of
; "Octet - Components.dc.html" (see docs/FEATURE_FIXES_BREAKDOWN.md WP-N).
; The component mockup uses 10px corner radius on buttons and 9px on
; inputs/dropdowns; the pre-existing default Button/Panel styles (8px /
; 11px) are left as-is to avoid an unreviewed visual change to every
; screen already built against them — per-screen fidelity passes
; (WP-G...L) can migrate onto the new variations deliberately.
; -----------------------------------------------------------------------

