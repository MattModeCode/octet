[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://ui/map_hub.gd" id="1_maphubgd"]
[ext_resource type="Theme" path="res://assets/theme/octet_theme.tres" id="2_theme"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_display.tres" id="3_fontdisplay"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_mono.tres" id="4_fontmono"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_ui.tres" id="5_fontui"]

; -----------------------------------------------------------------------
; Map Hub, header chrome imported from "Octet - Map Hub.dc.html" (browser
; view -- docs/DESIGN_HANDOFF.md pattern, Claude Design MCP project
; cc6f9e35-9183-4b42-8d8a-be6dfc135fe1). Colours baked as literal
; DesignTokens values -- .tscn parses before autoloads exist, same
; documented exception as game/song_select.tscn:
;   COLOR_INK             #0C0A0F -> Color(0.047, 0.039, 0.059, 1)
;   COLOR_SURFACE         #16131B -> Color(0.086275, 0.07451, 0.105882, 1)
;   COLOR_HAIRLINE        #2A2431 -> Color(0.164706, 0.141176, 0.192157, 1)
;   COLOR_TEXT_PRIMARY    #F5F1F5 -> Color(0.960784, 0.945098, 0.960784, 1)
;   COLOR_TEXT_SECONDARY  #A79FAE -> Color(0.654902, 0.623529, 0.682353, 1)
;   COLOR_TEXT_MUTED      #6E6676 -> Color(0.431373, 0.4, 0.462745, 1)
;
; Known deviations from the mockup (CLAUDE.md design-fidelity rule -- see
; map_hub.gd's header comment for why): the map grid and leaderboard are
; replaced with an honest "coming soon" empty state rather than the
; mockup's sample community data, since no map-sharing backend exists yet;
; the search field and sort/filter chips are rendered but disabled for the
; same reason; a Back button was added (not in the mockup, but necessary --
; this screen is otherwise a dead end from the main menu).
; -----------------------------------------------------------------------

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_header"]
bg_color = Color(0.047, 0.039, 0.059, 1)
border_width_bottom = 1
border_color = Color(0.164706, 0.141176, 0.192157, 1)
content_margin_left = 36.0
content_margin_top = 0.0
content_margin_right = 36.0
content_margin_bottom = 0.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_search_field"]
