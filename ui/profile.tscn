[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://ui/profile.gd" id="1_profilegd"]
[ext_resource type="Theme" path="res://assets/theme/octet_theme.tres" id="2_theme"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_display.tres" id="3_fontdisplay"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_mono.tres" id="4_fontmono"]
[ext_resource type="FontVariation" path="res://assets/fonts/font_ui.tres" id="5_fontui"]

; -----------------------------------------------------------------------
; Profile, imported from "Octet - Profile.dc.html" (Claude Design MCP,
; project cc6f9e35-9183-4b42-8d8a-be6dfc135fe1) per CLAUDE.md's
; design-fidelity rule. Colours baked as literal DesignTokens values --
; .tscn parses before autoloads exist, same documented exception as
; game/song_select.tscn:
;   COLOR_INK             #0C0A0F -> Color(0.047, 0.039, 0.059, 1)
;   COLOR_SURFACE         #16131B -> Color(0.086275, 0.07451, 0.105882, 1)
;   COLOR_HAIRLINE        #2A2431 -> Color(0.164706, 0.141176, 0.192157, 1)
;   COLOR_TEXT_PRIMARY    #F5F1F5 -> Color(0.960784, 0.945098, 0.960784, 1)
;   COLOR_TEXT_SECONDARY  #A79FAE -> Color(0.654902, 0.623529, 0.682353, 1)
;   COLOR_TEXT_MUTED      #6E6676 -> Color(0.431373, 0.4, 0.462745, 1)
;   COLOR_PINK            #FF2D6E -> Color(1, 0.176471, 0.431373, 1)
;
; Known deviations from the mockup (see profile.gd's header comment): the
; avatar is a flat pink circle rather than the mockup's pink-to-orchid
; gradient (same documented Godot limitation as ui/main.tscn's avatar
; chip); identity/rank/accuracy/pp are an honest "Guest"/"—" placeholder,
; not the mockup's sample "kayvox" data; "Recent plays" is an honest empty
; state (no play-history timestamps are persisted); a Back button was
; added (not in the mockup, but necessary -- this screen is otherwise a
; dead end from the main menu).
; -----------------------------------------------------------------------

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_avatar"]
bg_color = Color(1, 0.176471, 0.431373, 1)
corner_radius_top_left = 55
corner_radius_top_right = 55
corner_radius_bottom_right = 55
corner_radius_bottom_left = 55

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_stat_chip"]
bg_color = Color(0.086275, 0.07451, 0.105882, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.164706, 0.141176, 0.192157, 1)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12
content_margin_left = 26.0
content_margin_top = 16.0
content_margin_right = 26.0
content_margin_bottom = 16.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_panel"]
