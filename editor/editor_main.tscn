; Scene-local bar style: flat full-width bar (no corner radius, hairline
; bottom border only) -- matches the 2A mockup's top/difficulty/utility
; bars, distinct from the shared theme's rounded "card" PanelContainer
; style (which is still used for the waveform/inspector/tool-rail panels).
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bar"]
bg_color = Color(0.086275, 0.07451, 0.105882, 1)
border_width_bottom = 1
border_color = Color(0.164706, 0.141176, 0.192157, 1)
content_margin_left = 20.0
content_margin_right = 20.0
content_margin_top = 10.0
content_margin_bottom = 10.0

; Segmented-control group style (Snap 1/1-1/16 in the mockup): one shared
; dark bg + hairline border + rounded corners around the whole button row,
; with each button drawn flat (no individual border/radius) so they read as
; one joined pill, matching 2a's SNAP control.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_segment_group"]
bg_color = Color(0.121569, 0.101961, 0.14902, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.164706, 0.141176, 0.192157, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 0.0
content_margin_top = 0.0
content_margin_right = 0.0
content_margin_bottom = 0.0

; Start-overlay card style. Not in the "Octet - Editor.dc.html" mockup
; (which only shows the editor already mid-project) -- built on-brand from
; DESIGN_BRIEF.md's card/surface tokens per CLAUDE.md's design-fidelity
; rule, flagged here as a documented addition rather than a mockup match.
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_overlay_card"]
bg_color = Color(0.086275, 0.07451, 0.105882, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.164706, 0.141176, 0.192157, 1)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14
content_margin_left = 36.0
content_margin_top = 32.0
content_margin_right = 36.0
content_margin_bottom = 32.0

